# Copy to infra/.env.staging on the VM and fill in. NEVER commit .env.staging.
#
# Used by `make staging-up` (infra/docker-compose.staging.yml). Values here are
# deployment wiring only - every business number comes from `operator_config` through
# the admin screens (CLAUDE.md hard rule 4).
#
# Generate the three secrets below on the VM, not on a laptop, and not in a chat:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Application ------------------------------------------------------------
APP_ENV=staging
# Refuses to start if this is the default or shorter than 32 bytes (RFC 7518 §3.2).
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
LOG_LEVEL=INFO
LOG_JSON=true
# Must stay false outside APP_ENV=sim; settings refuse the combination (ADR-0008).
SIMCTL_ENABLED=false

# --- Public addresses -------------------------------------------------------
# Both must already resolve to this VM's public IP before the first `make staging-up`,
# or Caddy's ACME challenge fails and you get no certificate.
SITE_ADDRESS=staging.example.com
MONITORING_ADDRESS=grafana.staging.example.com
# A real mailbox. Let's Encrypt sends expiry warnings here.
ACME_EMAIL=ops@example.com

# --- Database ---------------------------------------------------------------
POSTGRES_DB=smartcab
POSTGRES_USER=smartcab
POSTGRES_PASSWORD=
# DATABASE_URL and REDIS_URL are NOT set here: the compose overrides them with the
# container addresses. Setting them would be ignored and would mislead the next reader.

# --- Broker -----------------------------------------------------------------
# The ingestor's own credential. Per-vehicle credentials are issued by the backend at
# duty start (B11) and written into the generated password and ACL files.
MQTT_INGESTOR_USER=ingestor
MQTT_INGESTOR_PASSWORD=
# Host port for the TLS listener. The container always listens on 8883; change this only
# if the host has 8883 taken (Windows reserves it on some machines) or something else
# fronts the broker.
MQTT_TLS_PORT=8883
# What a driver's phone is told to connect to - set by the compose from SITE_ADDRESS and
# the TLS port, because the API's own MQTT_HOST is a private service name. Listed here
# so the indirection is visible; overriding it is only right if something else fronts
# the broker, and the host must still match the certificate's SAN.
# MQTT_PUBLIC_HOST= / MQTT_PUBLIC_PORT= / MQTT_PUBLIC_TLS=

# --- Map services (ADR-0010) ------------------------------------------------
ROUTING_PROVIDER=cached_osrm
GEOCODING_PROVIDER=none
OSRM_URL=https://router.project-osrm.org
TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NOMINATIM_URL=
# REQUIRED in staging and prod: the app refuses to start without it when any configured
# map URL is a public OSM host. Use an address somebody reads.
OSM_CONTACT_EMAIL=
OSM_USER_AGENT=flex-platform/0.1
# Do not raise for public servers. After I02b, point OSRM_URL at http://osrm:5000 and
# this becomes yours to choose.
OSM_RATE_LIMIT_PER_SECOND=1
ROUTING_CACHE_TTL_SECONDS=900
OSM_REQUEST_TIMEOUT_SECONDS=5

# --- OTP and push -----------------------------------------------------------
# `console` prints the OTP to the log. Fine for an internal staging box with known
# testers; it must become a real SMS provider before anyone outside the team logs in
# (OQ-16).
OTP_PROVIDER=console
# `fcm` is not implemented and raises rather than dropping pushes silently (OQ-20).
PUSH_PROVIDER=log
NTFY_URL=
FCM_CREDENTIALS_FILE=

# --- Monitoring -------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=

# --- Image ------------------------------------------------------------------
# A git sha in CI; `local` when building on the box.
IMAGE_TAG=local
