{
  "uid": "smartcab-operations",
  "title": "Smart Cab \u2014 operations",
  "description": "The morning-peak view: are riders being served, are the cabs visible, and is the platform answering. Every panel is backed by a metric in backend/app/core/metrics.py.",
  "tags": [
    "smartcab",
    "r01"
  ],
  "timezone": "Asia/Kolkata",
  "editable": false,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "Service to riders",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Riders waiting",
      "description": "Requests asked for and not yet assigned to a cab. The number a supervisor is judged on.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(smartcab_pending_requests)",
          "legendFormat": "waiting",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "red",
                "value": 25
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Longest wait",
      "description": "How long the oldest unassigned rider has been waiting, measured from queued_at \u2014 the Clock-set origin, not the row's created_at (B09).",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "max(smartcab_longest_pending_wait_seconds)",
          "legendFormat": "oldest",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1200
              },
              {
                "color": "red",
                "value": 2700
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Trips under way",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(smartcab_trips_in_progress)",
          "legendFormat": "in progress",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Open alerts",
      "description": "Raised and not resolved. Critical is SOS.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (severity) (smartcab_open_alerts)",
          "legendFormat": "{{severity}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Riders waiting, and the longest wait",
      "description": "The shape of the morning. A queue that grows while the longest wait grows with it means nobody is dispatching; a queue that grows while the longest wait stays flat means demand is simply higher than the fleet.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(smartcab_pending_requests)",
          "legendFormat": "waiting",
          "refId": "A"
        },
        {
          "expr": "max(smartcab_longest_pending_wait_seconds) / 60",
          "legendFormat": "longest wait (min)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Tracking",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      }
    },
    {
      "type": "timeseries",
      "title": "GPS pings per second, by outcome",
      "description": "`accepted` against each drop reason from app/domain/gps.py. A drop reason climbing is OQ-33 happening again: half of every simulated run's GPS was discarded as too_far_future and nothing said so.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(smartcab_gps_pings_total[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Cabs on duty, and how many have gone quiet",
      "description": "Stale means no ping within stale_gps_seconds. One is a phone in a basement; a quarter of them is the platform.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(smartcab_vehicles_on_duty)",
          "legendFormat": "on duty",
          "refId": "A"
        },
        {
          "expr": "sum(smartcab_stale_vehicles)",
          "legendFormat": "stale",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Ping age at ingest (p50 / p95)",
      "description": "Broker to ingestor. non-functional.md wants a position visible within 10 s of the ping; this is the first half of that number.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(smartcab_gps_ingest_lag_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(smartcab_gps_ingest_lag_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Pings accepted against rows persisted",
      "description": "Accepted is what the ingestor took; persisted is what reached location_ping. They should track each other. Accepted climbing while persisted stays flat is a flush that has stopped - OQ-33's second cause, where written positions sat in an uncommitted transaction and were invisible to the API's own connection.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(smartcab_gps_pings_total{outcome=\"accepted\"}[5m]))",
          "legendFormat": "accepted/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(smartcab_gps_rows_written_total[5m]))",
          "legendFormat": "persisted/s",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Pings per cab per minute",
      "description": "rate(pings) / cabs on duty. non-functional.md asks for a per-vehicle rate; a UUID label would mint a series per cab, so it is derived instead. Expect ~12/min moving, ~2/min stationary.",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "60 * sum(rate(smartcab_gps_pings_total{outcome=\"accepted\"}[5m])) / clamp_min(sum(smartcab_vehicles_on_duty), 1)",
          "legendFormat": "pings/cab/min",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Platform",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 37
      }
    },
    {
      "type": "timeseries",
      "title": "API latency (p50 / p95 / p99)",
      "description": "Target: p95 \u2264 300 ms for non-optimizer endpoints (non-functional.md, Performance).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 38
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(smartcab_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(smartcab_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(smartcab_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.3
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Request rate and error rate",
      "description": "5xx is ours. 4xx is mostly clients being refused correctly, so it is shown apart rather than summed into one 'errors' line.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 38
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(smartcab_http_requests_total[5m]))",
          "legendFormat": "all",
          "refId": "A"
        },
        {
          "expr": "sum(rate(smartcab_http_requests_total{status=~\"4..\"}[5m]))",
          "legendFormat": "4xx",
          "refId": "B"
        },
        {
          "expr": "sum(rate(smartcab_http_requests_total{status=~\"5..\"}[5m]))",
          "legendFormat": "5xx",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Slowest endpoints (p95)",
      "description": "By route template. The one to watch is /api/v1/dispatch/requests/{request_id}/candidates, which does the routing work.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 46
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "topk(8, histogram_quantile(0.95, sum by (le, route) (rate(smartcab_http_request_duration_seconds_bucket[5m]))))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Routing (ADR-0010)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 54
      }
    },
    {
      "type": "timeseries",
      "title": "Where routing answers come from",
      "description": "cache / osrm / approx. The cache hit rate is what makes a 1 req/s budget usable; a rising `approx` share means OSRM is down, slow, or the budget is spent \u2014 and those ETAs are excluded from the accuracy target.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 55
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (source) (rate(smartcab_routing_requests_total[5m]))",
          "legendFormat": "{{source}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 20,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Share of ETAs served approximate, and refused tokens",
      "description": "A sustained share over 50% is the trigger to look at I02b (self-hosted OSRM). Refused tokens are calls the shared 1 req/s budget would not allow \u2014 they never reached a public server.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 55
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(smartcab_routing_requests_total{approximate=\"true\"}[15m])) / clamp_min(sum(rate(smartcab_routing_requests_total[15m])), 0.0001)",
          "legendFormat": "approximate share",
          "refId": "A"
        },
        {
          "expr": "sum(rate(smartcab_routing_rate_limited_total[15m]))",
          "legendFormat": "refused tokens/s",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Routing server latency (p50 / p95)",
      "description": "Time for a call that actually reached the routing server - not cache hits and not approx. This is what decides whether OSM_REQUEST_TIMEOUT_SECONDS fires and pushes an ETA onto the approx provider, so it leads the approximate-share panel.",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 63
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, operation) (rate(smartcab_routing_upstream_seconds_bucket[5m])))",
          "legendFormat": "{{operation}} p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(smartcab_routing_upstream_seconds_bucket[5m])))",
          "legendFormat": "{{operation}} p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Scheduled work (B20)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 70
      }
    },
    {
      "type": "timeseries",
      "title": "Sweep runs per minute, by outcome",
      "description": "expiry every 60 s, stop_etas and stale_vehicles every 30 s. A failing sweep is silent by design \u2014 the task logs and returns so one bad pass cannot stop the beat \u2014 so this panel is the only place it shows.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 71
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "60 * sum by (task, outcome) (rate(smartcab_sweep_runs_total[5m]))",
          "legendFormat": "{{task}} {{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Sweep duration (p95)",
      "description": "The stale-vehicle sweep once took ten seconds for 35 cabs because it queried per vehicle (OQ-26). If one of these climbs with fleet size, that is the shape to look for.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 71
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, task) (rate(smartcab_sweep_duration_seconds_bucket[5m])))",
          "legendFormat": "{{task}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    }
  ]
}
