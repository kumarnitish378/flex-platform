# --- Simulator outputs -----------------------------------------------------
simulator/runs/
runs/

# --- Infra / map data (large, never committed) -----------------------------
infra/data/
# Broker credential files are generated from the vehicle registry at runtime.
infra/mosquitto/config/generated/
infra/tiles/*.mbtiles
*.osm.pbf
*.osrm*

# --- Editors / OS ----------------------------------------------------------
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Downloaded build tools, cached per machine. `scripts/api_client.py` fetches the
# openapi-generator jar here on first run; it is pinned by version, so a checkout
# reproduces the same client without carrying 27 MB of jar in history.
.tooling/
