# Copy to .env and fill in. NEVER commit .env (see docs/05-engineering/dev-environment.md §4).

# --- Application -----------------------------------------------------------
APP_ENV=dev                      # dev | sim | staging | prod

# --- Database / cache / broker ---------------------------------------------
DATABASE_URL=postgresql+asyncpg://smartcab:smartcab@localhost:5432/smartcab
REDIS_URL=redis://localhost:6379/0
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_INGESTOR_USER=
MQTT_INGESTOR_PASSWORD=

# --- Map services (ADR-0010) ------------------------------------------------
# Public OSM servers in early phases. URLs ALWAYS come from here, never from code.
ROUTING_PROVIDER=cached_osrm     # cached_osrm | osrm | approx
GEOCODING_PROVIDER=none          # none (Phase 1) | nominatim (self-hosted only)
OSRM_URL=https://router.project-osrm.org
TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NOMINATIM_URL is intentionally unset: public Nominatim must never be used
# (its policy forbids vehicle-tracking applications). Self-hosted only, task I02c.
NOMINATIM_URL=

# Identifying User-Agent is required by the OSM usage policy. Use a REAL address.
OSM_USER_AGENT=flex-platform/0.1
OSM_CONTACT_EMAIL=you@example.com

# Public-server guard rails. Do not raise the rate limit for public servers.
OSM_RATE_LIMIT_PER_SECOND=1
ROUTING_CACHE_TTL_SECONDS=900

# --- Auth ------------------------------------------------------------------
JWT_SECRET=change-me-random-64-bytes
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OTP_PROVIDER=console             # console (dev) | <sms-provider>

# --- Notifications ---------------------------------------------------------
PUSH_PROVIDER=log                # log | fcm | ntfy
FCM_CREDENTIALS_FILE=

# --- Simulator -------------------------------------------------------------
SIMCTL_ENABLED=false             # true only when APP_ENV=sim
